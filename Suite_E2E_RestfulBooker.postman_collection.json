  "item": [
    {
      "name": "1. Autenticacion Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Extraer la respuesta JSON y guardar el token en la variable de entorno \"token\"\r",
              "\r",
              "var jsonData = pm.response.json();\r",
              "pm.environment.set(\"token\", jsonData.token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\" : \"admin\",\r\n    \"password\" : \"password123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. Crear Reserva",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Reserva creada exitosamente - Status 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "//extraer el bookingid y guardarlo en el entorno\r",
              "\r",
              "var jsonData = pm.response.json();\r",
              "pm.environment.set(\"bookingid\", jsonData.bookingid);\r",
              "\r",
              "//Validar que la reserva quedo a nombre de ernesto\r",
              "pm.test(\"El nombre de la reserva es Ernesto\", function () {\r",
              "    pm.expect(jsonData.booking.firstname).to.eql(\"Ernesto\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\":\"Ernesto\",\r\n    \"lastname\":\"Parada\",\r\n    \"totalprice\":1500,\r\n    \"depositpaid\":true,\r\n    \"bookingdates\":{\r\n        \"checkin\":\"2026-10-01\",\r\n        \"checkout\":\"2026-10-05\"\r\n    },\r\n    \"additionalneeds\": \"Desayuno incluido y habitación piso alto\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/booking",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Actualizar Reserva",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Reserva actualizada correctamente - Status 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"El precio se actualizó a 2000\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.totalprice).to.eql(2000);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Cookie",
            "value": "token={{token}}",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "{{basic_auth_083a}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\": \"Ernesto Antonio\",\r\n    \"lastname\": \"Parada\",\r\n    \"totalprice\": 2000,\r\n    \"depositpaid\": true,\r\n    \"bookingdates\": {\r\n        \"checkin\": \"2026-10-01\",\r\n        \"checkout\": \"2026-10-10\"\r\n    },\r\n    \"additionalneeds\": \"Desayuno y cena incluidos\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingid}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking",
            "{{bookingid}}"
          ]
        }
      },
      "response": []
    },
